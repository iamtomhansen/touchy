        "touchy.gearshift.track": (from: "touchy.palette.surface"),
        "touchy.gearshift.track.border": (from: "touchy.palette.edge"),

        // touchy.grabber
        "touchy.grabber.corner.mark": (from: "touchy.grabber.mark"),
