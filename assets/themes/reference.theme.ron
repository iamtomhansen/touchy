        "touchy.grabber.corner.mark:hover": (from: "touchy.grabber.mark:hover"),
        "touchy.grabber.corner.mark:pressed": (from: "touchy.grabber.mark:pressed"),
        "touchy.grabber.mark": (from: "touchy.palette.text.muted"),
        "touchy.grabber.mark:disabled": (from: "touchy.palette.text.muted", shade: Alpha(0.35)),
        "touchy.grabber.mark:hover": (from: "touchy.palette.highlight"),
        "touchy.grabber.mark:pressed": (from: "touchy.palette.highlight"),

        // touchy.grid
        "touchy.grid.bg": (from: "touchy.palette.surface"),
        "touchy.grid.border": (from: "touchy.palette.edge"),
        "touchy.grid.border:focused": (from: "touchy.palette.highlight"),
        "touchy.grid.cell": "transparent",
        "touchy.grid.cell:hover": (from: "touchy.palette.text", shade: Alpha(0.06)),
        "touchy.grid.chosen": (from: "touchy.palette.accent"),
        "touchy.grid.text": (from: "touchy.palette.text.muted"),
        "touchy.grid.text_chosen": (from: "touchy.grid.chosen", shade: Contrast),

        // touchy.joystick
        "touchy.joystick.bg": (from: "touchy.palette.surface"),
        "touchy.joystick.border": (from: "touchy.palette.edge"),
        "touchy.joystick.dead_zone": (from: "touchy.palette.text.muted", shade: Alpha(0.5)),
