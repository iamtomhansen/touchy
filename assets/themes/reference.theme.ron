        "touchy.slider.track.border": (from: "touchy.palette.edge"),

        // touchy.text_input
        "touchy.text_input.bg": (from: "touchy.palette.surface"),
        "touchy.text_input.border": (from: "touchy.palette.edge"),
        "touchy.text_input.border:focused": (from: "touchy.palette.highlight"),
