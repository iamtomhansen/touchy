        "touchy.palette.highlight": "#F2C740",
        "touchy.palette.info": "#408CD9",
        "touchy.palette.scrim": "#050A14B3",
        "touchy.palette.success": "#40D973",
        "touchy.palette.surface": "#1A1F29",
        "touchy.palette.text": "#F0F2F7",
        "touchy.palette.text.muted": "#949EB3",
